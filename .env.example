# Copy this file to .env and fill every required value. Never commit .env.
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:3000
VITE_API_URL=

# MongoDB (leave blank only for a non-persistent local demo)
MONGODB_URI=

# Generate long, unique values for each secret in production.
JWT_SECRET=
JWT_EXPIRES_IN=7d
ADMIN_JWT_SECRET=
ADMIN_NAME=Veloura Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Razorpay: obtain these from the Razorpay Dashboard. Do not use fallback keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional integrations
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
